%% 7. Multi-core
flowchart LR
  MAINP["Main process<br/>game loop, pyglet window, GL draw"]
  POOL["SteerBatcher pool<br/>3 spawn workers, shared memory arrays<br/>steer_chunk on snapshots"]
  GEO["geometry worker<br/>floor ops for the next arena"]
  PREL["preload worker<br/>decode menu music WAV"]
  THR["ThreadedLoader<br/>threads for I/O-bound reads"]
  MAINP -- "enemy batch, 16 or more live enemies" --> POOL
  POOL -- "steering results" --> MAINP
  MAINP -- "prefetch at menu" --> GEO
  GEO -- "ops for the Room build" --> MAINP
  MAINP -- "start at launch" --> PREL
  PREL -- "decoded sources" --> MAINP
  MAINP -- "asset reads" --> THR
