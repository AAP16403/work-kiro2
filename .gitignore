# Local game progress
progress.json

# Deterministic run recordings
replays/

# Local user settings (audio, shake, accessibility, run mutator selection)
user_settings.json

# Local high-score board, written at game over.
high_scores.json

# Save-file leftovers and temporary files from an interrupted atomic write
*.json.corrupt-*
.progress-*.tmp
.user_settings-*.tmp
.high_scores-*.tmp

# Claude Code session worktrees must never be committed
.claude/

# Player saves kept across rebuilds by build_all.bat
build_backup/
